# Copy this file to .env.local and fill in your anon key from:
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://ybuxmlwgjuxxuaqzctal.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Sign-in with Auth0 (Google and Apple). Until these are set up, and Supabase Third-Party Auth and
# supabase/migrations/20260921000000_per_user_rls.sql are done, nobody can sign in, and everyone sees the landing page.
# AUTH0_CLIENT_SECRET and AUTH0_SECRET are secrets. They are read only on the server and must never be committed.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-application-client-id
AUTH0_CLIENT_SECRET=your-auth0-application-client-secret
# Encrypts the session cookie. Generate one with: openssl rand -hex 32
AUTH0_SECRET=
# The address the app is served from, with no trailing slash.
APP_BASE_URL=http://localhost:3000
# Deleting an account also removes the sign-in from Auth0, which needs a separate Machine-to-Machine application with the
# "delete:users" permission (see the README). Without these two, "Delete my account and information" refuses and deletes nothing.
# AUTH0_MANAGEMENT_CLIENT_SECRET is a secret: server only, never committed.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Moonshot's assistant connector (/api/mcp, "Summon a plan"). The service role key bypasses row-level security: the
# connector filters every query to the person it verified. It is a secret: server only, never committed. Without it the
# connector answers that it isn't set up. MCP_RESOURCE_URL defaults to APP_BASE_URL + /api/mcp and must match the
# identifier of the Auth0 API for the connector (see the README).
SUPABASE_SERVICE_ROLE_KEY=
# MCP_RESOURCE_URL=https://your-app.example/api/mcp
# The Client ID of the one Auth0 application Claude signs in through (a Single Page Application: no secret, so it's
# public). The in-app steps show it for people to paste into Claude. Leave it empty to have Claude register itself.
NEXT_PUBLIC_CLAUDE_OAUTH_CLIENT_ID=
# The same for ChatGPT, through its own Auth0 application. ChatGPT is offered in "Summon a plan" only when this is set.
NEXT_PUBLIC_CHATGPT_OAUTH_CLIENT_ID=
# The planner needs a signed-in user unless this is exactly false. Set it to false only to work on the app locally
# before sign-in is set up. It also switches how the app talks to Supabase, so keep it out of production.
# NEXT_PUBLIC_AUTH_REQUIRED=false
